{
  "name": "doagol",
  "version": "0.1.0",
  "description": "DoaGol - Sistema de Gestão de Doações para Escolinhas de Futebol Social (API REST e front-end React)",
  "main": "src/domain/Necessidade.js",
  "files": [
    "src",
    "public"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build:front": "cd frontend && npm install && npm run build"
  },
  "author": "André Ihsan Ward, Rodrigo Lucas Mascarenhas Leite Oliveira, Cristian de Souza",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 100,
        "lines": 95,
        "statements": 95
      }
    }
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
